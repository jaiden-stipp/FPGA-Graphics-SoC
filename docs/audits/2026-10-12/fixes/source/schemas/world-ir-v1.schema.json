{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world-ir-v1.schema.json",
  "title": "Source-neutral multi-area world IR v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "resident_scene",
    "areas"
  ],
  "properties": {
    "format": {
      "const": "soc-world-ir"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "resident_scene": {
      "allOf": [
        {
          "$ref": "scene-ir-v1.schema.json"
        },
        {
          "if": {
            "required": [
              "controller"
            ]
          },
          "then": {
            "properties": {
              "controller": {
                "properties": {
                  "camera": {
                    "properties": {
                      "focal": {
                        "const": 256
                      },
                      "near_z": {
                        "const": 257
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "required": [
              "projection"
            ],
            "properties": {
              "projection": {
                "properties": {
                  "focal": {
                    "const": 256
                  },
                  "near_z": {
                    "const": 257
                  }
                }
              }
            }
          }
        }
      ]
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "vertices",
          "triangles",
          "collision",
          "spawn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "vertices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 16000
              }
            }
          },
          "spawn": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": -16000,
              "maximum": 16000
            }
          },
          "triangles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                }
              ]
            }
          },
          "triangle_room_masks": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "triangle_render_flags": {
            "type": "array",
            "items": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          "physics": {
            "type": "object",
            "required": [
              "speed",
              "radius",
              "height",
              "step_height",
              "gravity",
              "jump_speed",
              "kill_y"
            ],
            "additionalProperties": false,
            "properties": {
              "speed": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              },
              "radius": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              },
              "height": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              },
              "step_height": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              },
              "gravity": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              },
              "jump_speed": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              },
              "kill_y": {
                "type": "integer",
                "minimum": -16000,
                "maximum": 2048
              }
            }
          },
          "collision": {
            "type": "object",
            "required": [
              "vertices",
              "triangles"
            ],
            "properties": {
              "vertices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "integer",
                    "minimum": -16000,
                    "maximum": 16000
                  }
                }
              },
              "triangles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16384,
                "items": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    }
                  ]
                }
              },
              "triangle_forces": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -32768,
                  "maximum": 32767
                }
              },
              "surface_types": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              }
            }
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    "animation": {
      "type": "object"
    },
    "transitions": {
      "type": "array"
    },
    "event_exits": {
      "type": "array"
    },
    "implementation_status": {
      "type": "string"
    }
  }
}
